# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── Device polling ────────────────────────────────────────
# How often the backend re-fetches state from each device.
DEVICE_POLL_INTERVAL_MS=5000

# Mode: live | mock | fallback
#   live      → only call real devices; show offline if unreachable
#   mock      → never call real devices; serve fixture data
#   fallback  → try real devices, fall back to fixture data on failure (best for local dev)
DEVICE_MODE=fallback

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API + Socket.IO.
# Same-origin (Express serves the dashboard) needs nothing here.
# When the dashboard is hosted by WordPress on a different origin, add it here.
ALLOWED_ORIGINS=http://localhost:3000

# ─── Epiphan Pearl 2 (Faculty Podcast Studio) ──────────────
PEARL_HOST=10.56.1.138
PEARL_USERNAME=admin
PEARL_PASSWORD=replace-me

# ─── Canon CR-N300 cameras (Faculty Podcast Studio, ×3) ────
CANON_CAM1_HOST=10.56.1.101
CANON_CAM2_HOST=10.56.1.102
CANON_CAM3_HOST=10.56.1.103
CANON_USERNAME=admin
CANON_PASSWORD=replace-me

# ─── Mac Studio (Faculty Podcast Studio) ───────────────────
MAC_HOST=10.56.1.10
MAC_USER=studio
MAC_PORT=22
MAC_KEY_PATH=~/.ssh/id_ed25519
