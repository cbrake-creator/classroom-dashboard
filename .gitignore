# Static ffmpeg binary (~80MB) used by the sidecar for AV.io capture.
# Install via: curl + extract from https://evermeet.cx/ffmpeg/ — see
# sidecar/macos/build_bundle.sh for the expected path.
bin/ffmpeg

# go2rtc binary (~18MB) — RTSP→WebRTC bridge for the AV.io capture card.
# Install via download from https://github.com/AlexxIT/go2rtc/releases — see
# README / INSTALL.md for the expected path.
bin/go2rtc
