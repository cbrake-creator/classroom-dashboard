# ─── Where the dashboard is running ─────────────────────────
# Both an IP and a port. If running the dashboard on this same Mac,
# use http://localhost:3000.
DASHBOARD_URL=http://10.56.1.236:3000

# ─── Shared secret ──────────────────────────────────────────
# Must match SIDECAR_TOKEN in the dashboard backend/.env. Leave blank
# in both places if you're OK without auth (LAN-only setup).
SIDECAR_TOKEN=

# ─── Audio device matching ──────────────────────────────────
# The sidecar finds the Rodecaster by substring match against the
# system audio device name. RØDECaster Pro II advertises itself in
# Multi-Channel mode with 14 input channels. Adjust if you renamed
# the aggregate device in Audio MIDI Setup.
AUDIO_DEVICE_MATCH=RØDECaster
SAMPLE_RATE=48000
CHANNELS=14

# ─── Strip labels ───────────────────────────────────────────
# Comma-separated, in Rodecaster USB channel order. These are the
# labels the dashboard meter UI shows. Must equal CHANNELS count.
STRIPS=Mic 1 (Host),Mic 2 (Guest A),Mic 3 (Guest B),Mic 4 (Guest C),USB 1 (Mac L),USB 1 (Mac R),USB 2 L,USB 2 R,Bluetooth L,Bluetooth R,Sound Pad L,Sound Pad R,Mix-Minus L,Mix-Minus R

# ─── Where recordings go ────────────────────────────────────
# Multi-track WAV files, one session = one file. Path is relative
# to $HOME if not absolute.
OUTPUT_DIR=Documents/studio-daw-recordings

# ─── Telemetry tuning ───────────────────────────────────────
# Level-meter emit rate. 20 Hz (50ms) is snappy without swamping
# the websocket.
LEVELS_HZ=20

# Log level: debug | info | warning | error
LOG_LEVEL=info
