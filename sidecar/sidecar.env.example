# ─── Where the dashboard is running ─────────────────────────
# Both an IP and a port. If running the dashboard on this same Mac,
# use http://localhost:3000.
DASHBOARD_URL=http://localhost:3000

# ─── Shared secret ──────────────────────────────────────────
# Must match SIDECAR_TOKEN in the dashboard backend/.env. Leave blank
# in both places if you're OK without auth (LAN-only setup).
SIDECAR_TOKEN=

# ─── Audio device matching ──────────────────────────────────
# The sidecar finds the Rodecaster by substring match against the
# system audio device name. The RØDECaster Pro II exposes both a
# 2-ch "Chat" endpoint and a 14-ch "Main Multitrack" endpoint — we
# want the multitrack one. Adjust if you renamed the aggregate
# device in Audio MIDI Setup.
AUDIO_DEVICE_MATCH=Main Multitrack
SAMPLE_RATE=48000
CHANNELS=14

# ─── Strip labels ───────────────────────────────────────────
# Comma-separated, in Rodecaster USB channel order. These are the
# labels the dashboard meter UI shows. Must equal CHANNELS count.
# The RØDECaster Pro II multitrack layout is:
#   1-2 Main Mix (stereo)
#   3-4 Mic 1 (mono mic duplicated L/R)
#   5-6 Mic 2
#   7-8 Mic 3
#   9-10 Mic 4
#   11-14 — depends on firmware (USB / Bluetooth / Sound Pad / Chat)
STRIPS=Main Mix L,Main Mix R,Mic 1 (Host) L,Mic 1 (Host) R,Mic 2 (Guest A) L,Mic 2 (Guest A) R,Mic 3 (Guest B) L,Mic 3 (Guest B) R,Mic 4 (Guest C) L,Mic 4 (Guest C) R,Ch 11,Ch 12,Ch 13,Ch 14

# ─── Where recordings go ────────────────────────────────────
# Each session gets a timestamped subfolder with one WAV per
# recorded channel (see RECORD_CHANNELS). Path is relative to
# $HOME if not absolute, and can be changed at runtime from the
# dashboard's "Output Folder" input.
OUTPUT_DIR=Documents/studio-daw-recordings

# ─── Which channels get recorded ────────────────────────────
# Format: <channel>:<filename_stem>,<channel>:<filename_stem>,...
# Leave empty to record every one of CHANNELS channels (useful for
# diagnostic captures). Typical podcast setup records only the
# isolated mic channels — mics 1-4 live at ch 3/5/7/9 because each
# mono mic is duplicated across the L+R of its stereo pair.
RECORD_CHANNELS=3:Mic 1 (Host),5:Mic 2 (Guest A),7:Mic 3 (Guest B),9:Mic 4 (Guest C)

# ─── Telemetry tuning ───────────────────────────────────────
# Level-meter emit rate. 20 Hz (50ms) is snappy without swamping
# the websocket.
LEVELS_HZ=20

# Log level: debug | info | warning | error
LOG_LEVEL=info
